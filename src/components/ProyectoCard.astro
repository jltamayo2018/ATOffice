---
interface Props {
  titulo: string;
  tipos: string[];
  lugar: string;
  año: string;
  imagen: string;
  slug: string;
  destacado?: boolean;
}

const { titulo, tipos, lugar, año, imagen, slug } = Astro.props;

const tiposTexto = tipos.join(" · ");
---

<article id={slug} class="group fade-in">
  <div class="overflow-hidden bg-gris-claro aspect-4/5">
    <img
      src={imagen}
      alt={titulo}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
    />
  </div>

  <div class="pt-5">
    <div class="flex items-center justify-between gap-4 mb-2">
      <h3
        class="font-display text-3xl leading-tight group-hover:text-salvia transition-colors duration-300"
      >
        {titulo}
      </h3>

      <span class="text-xs text-gris whitespace-nowrap">{año}</span>
    </div>

    <p class="text-sm text-gris">
      {tiposTexto} · {lugar}
    </p>
  </div>
</article>
