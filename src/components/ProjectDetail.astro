---
import type { Project } from '@/data/projects';
import { worksLabels, translateWords, translateWord, archivingLabel, type Lang } from '@/i18n/translations';

interface Props {
  project: Project;
  active?: boolean;
  lang?: Lang;
}

const { project, active = false, lang = 'en' } = Astro.props;
const labels = worksLabels[lang];
const description = lang === 'es' ? project.descriptionEs : project.description;
---

<article
  class:list={['detail', { 'is-active': active }]}
  data-project-detail={project.slug}
  aria-hidden={active ? 'false' : 'true'}
>
  <button type="button" class="detail__close label muted" data-close-detail>
    {labels.close}
  </button>

  {project.hasContent ? (
    <>
      <header class="detail__cabecera">
        <h2 class="detail__titulo">{project.title}</h2>
        <dl class="detail__meta">
          <div>
            <dt class="label muted">{labels.type}</dt>
            <dd>{translateWords(project.type, lang).join(' · ')}</dd>
          </div>
          <div>
            <dt class="label muted">{labels.location}</dt>
            <dd>{translateWord(project.location, lang)}</dd>
          </div>
          <div>
            <dt class="label muted">{labels.year}</dt>
            <dd>{project.year}</dd>
          </div>
          <div>
            <dt class="label muted">{labels.client}</dt>
            <dd>{translateWord(project.client, lang)}</dd>
          </div>
          <div>
            <dt class="label muted">{labels.phase}</dt>
            <dd>{translateWords(project.phase, lang).join(' · ')}</dd>
          </div>
        </dl>
      </header>

      <p class="detail__descripcion">{description}</p>

      <img
        class="detail__imagen img-reveal"
        src={project.image}
        alt={project.title}
        loading="lazy"
      />
    </>
  ) : (
    <>
      <header class="detail__cabecera detail__cabecera--simple">
        <h2 class="detail__titulo">{project.title}</h2>
        <p class="detail__subtitulo muted">
          {translateWords(project.type, lang).join(' · ')} · {project.year}
        </p>
      </header>

      <p class="detail__archiving muted">{archivingLabel[lang]}</p>
    </>
  )}
</article>

<style>
  .detail {
    display: none;
    flex-direction: column;
    gap: var(--space-5);
  }

  .detail.is-active {
    display: flex;
  }

  .detail__close {
    align-self: flex-end;
    transition: color var(--transition-fast);
  }

  .detail__close:hover {
    color: var(--color-text);
  }

  .detail__cabecera {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
    padding-bottom: var(--space-4);
  }

  .detail__cabecera--simple {
    align-items: baseline;
  }

  .detail__titulo {
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .detail__subtitulo {
    font-size: var(--fs-body);
  }

  .detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .detail__meta dt {
    margin-bottom: var(--space-1);
  }

  .detail__descripcion {
    max-width: 60ch;
    font-size: var(--fs-lead);
  }

  .detail__archiving {
    font-size: var(--fs-lead);
    padding-top: var(--space-6);
  }

  .detail__imagen {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-bg-alt);
  }
</style>
