---
// Cambia SKIP_INTRO a true si quieres desactivarla temporalmente
---

<div
    id="intro-overlay"
    class="fixed inset-0 z-[100] flex items-center justify-center bg-crema"
    aria-hidden="true"
>
    <svg
        id="intro-svg"
        viewBox="0 0 580 115"
        xmlns="http://www.w3.org/2000/svg"
        class="w-[99vw] max-w-4xl"
    >
        <circle id="intro-dot" cx="13" cy="26" r="7" fill="#7A8C6E" opacity="0"
        ></circle>

        <text
            id="intro-text"
            x="30"
            y="85"
            font-family="'Instrument Sans', system-ui, sans-serif"
            font-weight="600"
            font-size="100"
            letter-spacing="-2"
            fill="none"
            stroke="#111111"
            stroke-width="1.5"
            stroke-dasharray="3200"
            stroke-dashoffset="3200"
        >
            ATOFFICE
        </text>
    </svg>
</div>

<style>
    #intro-text {
        transition: stroke-dashoffset 4.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #intro-dot {
        transition:
            opacity 0.4s ease,
            transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        transform-origin: 13px 26px;
        transform: scale(0);
    }

    #intro-overlay {
        transition: opacity 0.7s ease;
    }

    #intro-overlay.fade-out {
        opacity: 0;
        pointer-events: none;
    }
</style>

<script>
    const visto = sessionStorage.getItem("intro-visto");

    const overlay = document.getElementById("intro-overlay");
    const text = document.querySelector<SVGTextElement>("#intro-text");
    const dot = document.querySelector<SVGCircleElement>("#intro-dot");

    if (!overlay || !text || !dot) {
        console.warn("IntroAnimation: no se encontraron todos los elementos.");
    } else if (visto) {
        overlay.style.display = "none";
        document.body.classList.remove("intro-activa");
        document.body.classList.add("intro-finalizada");
    } else {
        document.body.style.overflow = "hidden";
        document.body.classList.add("intro-activa");

        requestAnimationFrame(() => {
            setTimeout(() => {
                dot.style.opacity = "1";
                dot.style.transform = "scale(1)";

                setTimeout(() => {
                    text.style.strokeDashoffset = "0";
                }, 200);

                setTimeout(() => {
                    overlay.classList.add("fade-out");

                    document.body.classList.remove("intro-activa");
                    document.body.classList.add("intro-finalizada");

                    document.body.style.overflow = "";

                    setTimeout(() => {
                        overlay.style.display = "none";
                    }, 400);

                    sessionStorage.setItem("intro-visto", "1");
                }, 2500);
            }, 100);
        });
    }
</script>
