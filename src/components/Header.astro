---
const { currentPath = "/" } = Astro.props;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/estudio", label: "Estudio" },
  { href: "/contacto", label: "Contacto" },
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<header
  class="sticky top-0 z-50 bg-crema/90 backdrop-blur-md border-b border-gris-claro"
>
  <div
    class="max-w-6xl mx-auto px-6 md:px-12 py-5 flex items-center justify-between"
  >
    <a href="/" class="tracking-[0.25em] uppercase text-sm font-medium">
      ATOFFICE
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`link-menu ${isActive(item.href) ? "text-negro" : "text-gris hover:text-negro"}`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      id="menu-button"
      class="md:hidden text-xs tracking-[0.25em] uppercase"
      aria-label="Abrir menú"
    >
      Menú
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gris-claro bg-crema"
  >
    <nav class="px-6 py-6 flex flex-col gap-5">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`link-menu ${isActive(item.href) ? "text-negro" : "text-gris"}`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
