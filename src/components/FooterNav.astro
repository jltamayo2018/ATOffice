---
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/works', label: 'Works' },
  { href: '/info', label: 'Info' },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<nav class:list={['footer-nav', { 'footer-nav--overlay': overlay }]} transition:animate="none">
  <div class="footer-nav__group">
    <a href="/" class:list={['footer-nav__brand', { 'is-active': path === '/' }]}>
      ATOFFICE
    </a>
    {links.map((link) => (
      <a
        href={link.href}
        class:list={['footer-nav__link', 'label', { 'is-active': isActive(link.href) }]}
      >
        {link.label}
      </a>
    ))}
    <button type="button" class="footer-nav__link label" data-contact-open>
      Contact
    </button>
  </div>

  <div class="footer-nav__group">
    <!--
      Selector de idioma: por ahora solo existe la versión EN (principal).
      Cuando el contenido ES esté listo, activar el link de abajo
      (quitar aria-disabled/pointer-events y apuntarlo a la ruta /es
      equivalente a la página actual).
    -->
    <div class="footer-nav__lang label" aria-label="Language selector">
      <span class="is-active">EN</span>
      <span class="footer-nav__lang-divider">/</span>
      <span class="footer-nav__lang-disabled" aria-disabled="true">ES</span>
    </div>
    <a
      href="https://www.instagram.com/at.context/"
      target="_blank"
      rel="noreferrer"
      class="footer-nav__link label pc-only"
    >
      Instagram
    </a>
  </div>
</nav>

<style>
  .footer-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0 var(--content-padding-x);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .footer-nav--overlay {
    background: transparent;
    border-top: none;
  }

  .footer-nav__group {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .footer-nav__group::-webkit-scrollbar {
    display: none;
  }

  .footer-nav__brand {
    font-weight: 800;
    font-size: var(--fs-nav);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-nav__link {
    white-space: nowrap;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-nav__brand.is-active,
  .footer-nav__link.is-active {
    color: var(--color-text);
    font-weight: 800;
  }

  .footer-nav__brand:hover,
  .footer-nav__link:hover {
    color: var(--color-text);
  }

  .footer-nav__lang {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    white-space: nowrap;
  }

  .footer-nav__lang .is-active {
    color: var(--color-text);
    font-weight: 600;
  }

  .footer-nav__lang-divider {
    color: var(--color-border-soft);
  }

  .footer-nav__lang-disabled {
    color: var(--color-border-soft);
  }

  @media (max-width: 640px) {
    .footer-nav__group {
      gap: var(--space-3);
    }
  }
</style>
