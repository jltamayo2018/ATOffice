---
import type { Lang } from '@/i18n/translations';

interface Props {
  overlay?: boolean;
  lang?: Lang;
}

const { overlay = false, lang = 'en' } = Astro.props;

const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Ruta actual sin el prefijo /es, para poder construir tanto la versión EN
// como la ES del mismo enlace (home, works, info, works/[slug]...).
const pathWithoutLang = rawPath === '/es' || rawPath.startsWith('/es/')
  ? rawPath.slice(3) || '/'
  : rawPath;

const withLang = (targetLang: Lang, path: string) =>
  targetLang === 'es' ? (path === '/' ? '/es' : `/es${path}`) : path;

const homeHref = withLang(lang, '/');
const links = [
  { href: withLang(lang, '/works'), label: 'Works', match: '/works' },
  { href: withLang(lang, '/info'), label: 'Info', match: '/info' },
];

const isActive = (matchPath: string) => {
  const target = withLang(lang, matchPath);
  return rawPath === target || rawPath.startsWith(target + '/');
};

const enHref = withLang('en', pathWithoutLang);
const esHref = withLang('es', pathWithoutLang);
---

<nav class:list={['footer-nav', { 'footer-nav--overlay': overlay }]} transition:animate="none">
  <div class="footer-nav__group">
    <a href={homeHref} class:list={['footer-nav__brand', { 'is-active': rawPath === homeHref }]}>
      AToffice
    </a>
    {links.map((link) => (
      <a
        href={link.href}
        class:list={['footer-nav__link', 'label', { 'is-active': isActive(link.match) }]}
      >
        {link.label}
      </a>
    ))}
    <button type="button" class="footer-nav__link label" data-contact-open>
      Contact
    </button>
  </div>

  <div class="footer-nav__group">
    <div class="footer-nav__lang label" aria-label="Language selector">
      {lang === 'en' ? (
        <span class="is-active">EN</span>
      ) : (
        <a href={enHref}>EN</a>
      )}
      <span class="footer-nav__lang-divider">/</span>
      {lang === 'es' ? (
        <span class="is-active">ES</span>
      ) : (
        <a href={esHref}>ES</a>
      )}
    </div>
    <a
      href="https://www.instagram.com/at.context/"
      target="_blank"
      rel="noreferrer"
      class="footer-nav__link label pc-only"
    >
      Instagram
    </a>
  </div>
</nav>

<style>
  .footer-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0 var(--content-padding-x);
    background: var(--color-bg);
  }

  .footer-nav--overlay {
    background: transparent;
  }

  .footer-nav__group {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .footer-nav__group::-webkit-scrollbar {
    display: none;
  }

  /* Chips: mismo tratamiento que la referencia (studioapt.kr) para los
     enlaces del nav — fondo translúcido, esquinas rectas, un punto más
     de peso visual que un simple enlace de texto. El desenfoque de fondo
     es progresivo: si el navegador no soporta backdrop-filter, el chip
     sigue siendo legible gracias al propio fondo translúcido. */
  .footer-nav__brand,
  .footer-nav__link {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 6px 10px 4px;
    background: var(--color-chip-bg);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--color-text-muted);
    font-weight: 700;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .footer-nav__brand {
    font-size: var(--fs-nav);
    letter-spacing: var(--tracking-wide);
  }

  .footer-nav__brand:hover,
  .footer-nav__link:hover {
    background: var(--color-chip-bg-hover);
    color: var(--color-text);
  }

  /* Activo: mismo chip, sin invertir a negro — solo texto oscuro,
     igual criterio que el hover pero permanente. */
  .footer-nav__brand.is-active,
  .footer-nav__link.is-active {
    background: var(--color-chip-bg-hover);
    color: var(--color-text);
  }

  .footer-nav__lang {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    white-space: nowrap;
  }

  .footer-nav__lang .is-active {
    color: var(--color-text);
  }

  .footer-nav__lang a {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-nav__lang a:hover {
    color: var(--color-text);
  }

  .footer-nav__lang-divider {
    color: var(--color-border-soft);
  }

  @media (max-width: 640px) {
    .footer-nav__group {
      gap: var(--space-3);
    }
  }
</style>
