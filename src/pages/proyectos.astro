---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProyectoCard from "../components/ProyectoCard.astro";

const proyectos = [
  {
    titulo: "BALMIS_BUILDING COMPLEX FOR 9 LUXURY FLATS",
    tipos: ["License Management"],
    lugar: "Madrid",
    año: "2023-2025",
    imagen: "/images/proyectos/BALMIS_BUILDING_COMPLEX_FOR_9_LUXURY_FLATS.png",
    slug: "balmis-building-complex-for-9-luxury-flats",
    destacado: true,
  },
  {
    titulo: "NBA_BUILDING COMPLEX FOR A 5*HOTEL + SPORT CENTER",
    tipos: ["License Management"],
    lugar: "Malasaña, Madrid",
    año: "2023-2025",
    imagen:
      "/images/proyectos/NBA_BUILDING_COMPLEX_FOR_A_5_HOTEL_PLUS_SPORT_CENTER.png",
    slug: "nba-building-complex-for-a-5-hotel-plus-sport-center",
  },
  {
    titulo: "EZ8_RESIDENTIAL RENOVATION PROJECTS & SITE MANAGEMENT",
    tipos: ["Construction Management", "Design"],
    lugar: "Sierra de Madrid",
    año: "2024-2025",
    imagen:
      "/images/proyectos/EZ8_RESIDENTIAL_RENOVATION_PROJECTS_AND_SITE_MANAGEMENT.png",
    slug: "ez8-residential-renovation-projects-and-site-management",
  },
];

// Tipos únicos para el filtro
const tipos = ["Todos", ...new Set(proyectos.flatMap((p) => p.tipos))];
---

<BaseLayout
  title="Proyectos — ATOFFICE"
  description="Portfolio de reformas integrales, diseño de interiores y arquitectura de ATOFFICE en Madrid."
>
  <!-- Cabecera -->
  <section class="py-24 px-6 md:px-12 max-w-6xl mx-auto">
    <p
      class="text-xs tracking-[0.3em] uppercase text-salvia mb-6 font-light fade-in"
    >
      Portfolio
    </p>
    <h1 class="font-display text-seccion font-light fade-in">Proyectos</h1>
  </section>

  <!-- Filtros -->
  <div class="px-6 md:px-12 max-w-6xl mx-auto mb-12">
    <div class="linea-divisor mb-8"></div>
    <div class="flex flex-wrap gap-3" id="filtros">
      {
        tipos.map((tipo) => (
          <button
            data-filter={tipo === "Todos" ? "todos" : tipo}
            class={`filtro-btn text-xs tracking-widest uppercase font-light px-4 py-2 border transition-all duration-200
                  ${tipo === "Todos" ? "border-negro bg-negro text-crema" : "border-gris-claro text-gris hover:border-negro hover:text-negro"}`}
          >
            {tipo}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Grid de proyectos -->
  <section class="px-6 md:px-12 max-w-6xl mx-auto pb-32">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
      id="proyectos-grid"
    >
      {
        proyectos.map((p, i) => (
          <div
            data-tipos={p.tipos.join("|")}
            class="proyecto-item fade-in"
            style={`transition-delay: ${i * 0.07}s`}
          >
            <ProyectoCard {...p} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const btns = document.querySelectorAll(".filtro-btn");
  const items = document.querySelectorAll(".proyecto-item");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");

      btns.forEach((b) => {
        b.classList.remove("border-negro", "bg-negro", "text-crema");
        b.classList.add("border-gris-claro", "text-gris");
      });

      btn.classList.add("border-negro", "bg-negro", "text-crema");
      btn.classList.remove("border-gris-claro", "text-gris");

      items.forEach((item) => {
        const itemElement = item as HTMLElement;
        const tipos = itemElement.getAttribute("data-tipos")?.split("|") || [];

        if (filter === "todos" || tipos.includes(filter || "")) {
          itemElement.style.display = "";
        } else {
          itemElement.style.display = "none";
        }
      });
    });
  });
</script>
