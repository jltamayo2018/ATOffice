---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { infoContent, type Lang } from '@/i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const content = infoContent[lang];

const pageTitle = lang === 'es' ? 'Estudio' : 'Info';
---

<BaseLayout title={pageTitle} lang={lang}>
  <main class="page info">
    <div class="info__col info__col--left">
      <section class="info__about">
        <h1 class="label">{content.aboutLabel}</h1>
        <p class="info__texto">{content.aboutText}</p>
      </section>

      <section class="info__service">
        <h2 class="label">{content.servicesLabel}</h2>
        <div class="info__servicios">
          {content.services.map((service) => (
            <div class="info__servicio">
              <span class="info__servicio-titulo">{service.title}</span>
              <p class="info__servicio-desc muted">{service.body}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div class="info__col info__col--right">
      <section class="info__process">
        <h2 class="label">{content.processLabel}</h2>
        <p class="info__texto">{content.processText}</p>
        <img
          class="info__diagrama"
          src="/images/studio/proceso-diagrama.png"
          alt={content.processLabel}
          loading="lazy"
        />
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-5);
    align-items: start;
    padding-top: var(--space-2);
  }

  .info__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info__about,
  .info__process,
  .info__service {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info__about .info__texto,
  .info__process .info__texto {
    max-width: 56ch;
  }

  .info__texto {
    font-size: var(--fs-body);
  }

  .info__diagrama {
    width: 100%;
    max-width: 360px;
    margin-top: var(--space-2);
    border: 1px solid var(--color-border-soft);
  }

  .info__servicios {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info__servicio {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .info__servicio-titulo {
    font-weight: 700;
  }

  .info__servicio-desc {
    font-size: var(--fs-body);
    max-width: 60ch;
  }

  @media (max-width: 800px) {
    .info {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }
  }
</style>
