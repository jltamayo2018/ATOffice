---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Servicios from "../components/Servicios.astro";
import ProyectoCard from "../components/ProyectoCard.astro";

// Proyectos destacados para la home (muestra solo 3)
const proyectosDestacados = [
  {
    titulo: "BALMIS_BUILDING COMPLEX FOR 9 LUXURY FLATS",
    tipos: ["License Management"],
    lugar: "Madrid",
    año: "2023-2025",
    imagen: "/images/proyectos/BALMIS_BUILDING_COMPLEX_FOR_9_LUXURY_FLATS.png",
    slug: "balmis-building-complex-for-9-luxury-flats",
    destacado: true,
  },
  {
    titulo: "NBA_BUILDING COMPLEX FOR A 5*HOTEL + SPORT CENTER",
    tipos: ["License Management"],
    lugar: "Malasaña, Madrid",
    año: "2023-2025",
    imagen:
      "/images/proyectos/NBA_BUILDING_COMPLEX_FOR_A_5_HOTEL_PLUS_SPORT_CENTER.png",
    slug: "nba-building-complex-for-a-5-hotel-plus-sport-center",
  },
  {
    titulo: "EZ8_RESIDENTIAL RENOVATION PROJECTS & SITE MANAGEMENT",
    tipos: ["Construction Management", "Design"],
    lugar: "Sierra de Madrid",
    año: "2024-2025",
    imagen:
      "/images/proyectos/EZ8_RESIDENTIAL_RENOVATION_PROJECTS_AND_SITE_MANAGEMENT.png",
    slug: "ez8-residential-renovation-projects-and-site-management",
  },
];
---

<BaseLayout
  title="ATOFFICE — Arquitectura e Interiorismo en Madrid"
  description="Estudio de arquitectura especializado en reformas integrales, diseño de interiores y proyectos llave en mano en Madrid."
>
  <!-- Hero -->
  <Hero />

  <!-- Servicios -->
  <Servicios />

  <!-- Proyectos destacados -->
  <section class="py-24 px-6 md:px-12 max-w-6xl mx-auto">
    <div class="linea-divisor mb-16"></div>

    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6"
    >
      <h2 class="font-display text-seccion fade-in">Proyectos</h2>
      <a
        href="/proyectos"
        class="text-sm tracking-widest uppercase text-salvia hover:text-negro transition-colors duration-300 font-light fade-in"
      >
        Ver todos →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {proyectosDestacados.map((p) => <ProyectoCard {...p} />)}
    </div>
  </section>

  <!-- Bloque CTA -->
  <section class="py-24 px-6 md:px-12 bg-negro text-crema">
    <div
      class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-12"
    >
      <div>
        <h2 class="font-display text-seccion font-light leading-tight fade-in">
          ¿Tienes un proyecto<br />en mente?
        </h2>
        <p
          class="text-crema/60 font-light mt-4 max-w-sm text-sm leading-relaxed fade-in"
        >
          Primera reunión sin compromiso. Cuéntanos qué imaginas y estudiamos
          cómo hacerlo posible.
        </p>
      </div>
      <div class="fade-in">
        <a
          href="/contacto"
          class="inline-block px-10 py-4 border border-crema text-sm tracking-widest uppercase font-light
                                   hover:bg-crema hover:text-negro transition-all duration-300"
        >
          Hablemos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
