---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroGallery from "@/components/HeroGallery.astro";
import { homeManifesto, type Lang } from "@/i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const pageTitle = lang === 'es' ? 'Inicio' : 'Home';
---

<BaseLayout title={pageTitle} lang={lang} navOverlay>
  <div class="hero-screen">
    <div class="hero-screen__gallery">
      <HeroGallery />
    </div>

    <p class="hero-screen__manifiesto">
      {homeManifesto[lang]}
    </p>
  </div>
</BaseLayout>

<style>
  .hero-screen {
    position: relative;
    height: 100svh;
  }

  .hero-screen__gallery {
    position: absolute;
    inset: 0;
  }

  .hero-screen__manifiesto {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 6;
    padding: var(--space-4) var(--content-padding-x);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
</style>
