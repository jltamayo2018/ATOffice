---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactoForm from '../components/ContactoForm.astro';
---

<BaseLayout
  title="Contacto — Tu Estudio"
  description="Contacta con Tu Estudio para reformas integrales, arquitectura, interiorismo y proyectos llave en mano en Madrid."
>

  <section class="py-24 px-6 md:px-12 max-w-6xl mx-auto">
    <p class="text-xs tracking-[0.3em] uppercase text-salvia mb-6 font-light fade-in">
      Contacto
    </p>

    <h1 class="font-display text-seccion font-light max-w-4xl fade-in">
      Cuéntanos qué espacio quieres transformar.
    </h1>
  </section>

  <section class="px-6 md:px-12 max-w-6xl mx-auto pb-32">
    <div class="linea-divisor mb-16"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <div class="lg:col-span-5 fade-in">
        <h2 class="font-display text-4xl mb-8">
          Empecemos por una conversación.
        </h2>

        <p class="text-gris leading-relaxed mb-10">
          Escríbenos para contarnos tu proyecto. Podemos ayudarte si estás
          pensando en reformar una vivienda, diseñar un local comercial o
          desarrollar un proyecto desde cero.
        </p>

        <div class="space-y-6 text-sm">
          <div>
            <p class="text-xs tracking-widest uppercase text-gris mb-2">Email</p>
            <a href="mailto:hola@tuestudio.com" class="hover:text-salvia transition-colors">
              hola@tuestudio.com
            </a>
          </div>

          <div>
            <p class="text-xs tracking-widest uppercase text-gris mb-2">Teléfono</p>
            <a href="tel:+34600000000" class="hover:text-salvia transition-colors">
              +34 600 000 000
            </a>
          </div>

          <div>
            <p class="text-xs tracking-widest uppercase text-gris mb-2">Ubicación</p>
            <p>Madrid, España</p>
          </div>

          <div>
            <p class="text-xs tracking-widest uppercase text-gris mb-2">Instagram</p>
            <a href="https://www.instagram.com/" target="_blank" class="hover:text-salvia transition-colors">
              @tuestudio
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 fade-in">
        <ContactoForm />
      </div>
    </div>
  </section>

</BaseLayout>